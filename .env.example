# Server
NODE_ENV=development
PORT=5000
BASE_URL=http://localhost:5000

# Database
DATABASE_URL="mysql://root:password@localhost:3306/fashion_ecommerce"

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here_min_32_chars
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# File Storage
UPLOAD_PATH=./uploads
# 25 MB. Originals are stored untouched at full quality; the storefront is
# served resized derivatives instead, so a large ceiling here costs page speed
# nothing. See src/utils/imagePipeline.ts.
MAX_FILE_SIZE=26214400
# Reel videos only. Keep nginx client_max_body_size above this.
MAX_VIDEO_SIZE=209715200
ALLOWED_IMAGE_TYPES=image/jpeg,image/jpg,image/png,image/webp,image/avif,image/tiff

# ── Image delivery pipeline ────────────────────────────────────────────────
# Disk cache for generated derivatives. Must be on the same persistent volume
# as UPLOAD_PATH. Dot-prefixed so the /uploads static handler never exposes it.
IMAGE_CACHE_PATH=./uploads/.derivatives
# ~100 megapixels. Bounds decode memory against decompression-bomb uploads.
IMAGE_MAX_INPUT_PIXELS=100000000
# libvips threads PER PM2 worker. Keep low: workers x threads oversubscribes CPU.
SHARP_CONCURRENCY=2
# Formats generated ahead of time. AVIF is primary, WebP is the fallback.
IMAGE_PREWARM_FORMATS=avif,webp
# Set false to skip on-upload pre-warming on a memory-tight box.
IMAGE_PREWARM_ON_UPLOAD=true
# Concurrent background encodes. Leave at 1 on a 1-2 core VPS.
IMAGE_BACKGROUND_CONCURRENCY=1
IMAGE_MAX_BACKGROUND_QUEUE=500

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email — required for delivery confirmation codes on self-delivered orders.
# Two ways out; set ONE of them.
#
# 1. Brevo HTTP API (preferred — faster, and it says why when it refuses).
#    The key is created at Brevo → SMTP & API → API Keys, and starts "xkeysib-".
BREVO_API_KEY=

# 2. SMTP, used only when BREVO_API_KEY is empty. Works with Brevo's relay
#    (smtp-relay.brevo.com:587, login from Brevo → SMTP & API, password is the
#    SMTP key starting "xsmtpsib-") or with any other SMTP server.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# The From address. With Brevo this MUST be a verified sender or an address on
# a domain you have authenticated there, or every send is refused.
FROM_EMAIL=noreply@fashionstore.com
FROM_NAME=Fashion Store

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000/admin

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Bcrypt
BCRYPT_ROUNDS=12
